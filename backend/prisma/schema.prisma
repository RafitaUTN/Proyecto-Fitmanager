generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gimnasio {
  id_gimnasio    BigInt   @id @default(autoincrement())
  nombre         String
  correo         String   @unique
  telefono       String?
  direccion      String?
  estado         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuarios   Usuario[]
  clientes   Cliente[]
  membresias Membresia[]

  @@map("gimnasio")
}

model Usuario {
  id_usuario     BigInt   @id @default(autoincrement())
  id_gimnasio    BigInt
  nombre         String
  apellido       String
  correo         String   @unique
  password_hash  String
  rol            String
  estado         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  gimnasio Gimnasio @relation(fields: [id_gimnasio], references: [id_gimnasio])
  rutinas  Rutina[]

  @@index([id_gimnasio])
  @@map("usuario")
}

model Cliente {
  id_cliente       BigInt   @id @default(autoincrement())
  id_gimnasio      BigInt
  nombre           String
  apellido         String
  cedula           String   @unique
  telefono         String?
  correo           String   @unique
  fecha_nacimiento DateTime? @db.Date
  fecha_registro   DateTime @default(now())
  estado           Boolean  @default(true)

  gimnasio           Gimnasio           @relation(fields: [id_gimnasio], references: [id_gimnasio])
  cliente_membresias ClienteMembresia[]
  pagos              Pago[]
  asistencias        Asistencia[]
  cliente_rutinas    ClienteRutina[]
  notificaciones     Notificacion[]

  @@index([id_gimnasio])
  @@index([correo])
  @@index([cedula])
  @@map("cliente")
}

model Membresia {
  id_membresia  BigInt   @id @default(autoincrement())
  id_gimnasio   BigInt
  nombre        String
  descripcion   String?
  precio        Decimal  @db.Decimal(10, 2)
  duracion_dias Int
  estado        Boolean  @default(true)

  gimnasio           Gimnasio           @relation(fields: [id_gimnasio], references: [id_gimnasio])
  cliente_membresias ClienteMembresia[]

  @@map("membresia")
}

model ClienteMembresia {
  id_cliente_membresia BigInt    @id @default(autoincrement())
  id_cliente           BigInt
  id_membresia         BigInt
  fecha_inicio         DateTime  @db.Date
  fecha_fin            DateTime  @db.Date
  estado               String

  cliente    Cliente    @relation(fields: [id_cliente], references: [id_cliente])
  membresia  Membresia  @relation(fields: [id_membresia], references: [id_membresia])
  pagos      Pago[]

  @@index([id_cliente])
  @@index([estado])
  @@map("cliente_membresia")
}

model Pago {
  id_pago              BigInt   @id @default(autoincrement())
  id_cliente           BigInt
  id_cliente_membresia BigInt
  monto                Decimal  @db.Decimal(10, 2)
  metodo_pago          String
  fecha_pago           DateTime @default(now())
  estado               String

  cliente           Cliente          @relation(fields: [id_cliente], references: [id_cliente])
  cliente_membresia ClienteMembresia @relation(fields: [id_cliente_membresia], references: [id_cliente_membresia])

  @@index([id_cliente])
  @@index([fecha_pago])
  @@map("pago")
}

model Asistencia {
  id_asistencia      BigInt    @id @default(autoincrement())
  id_cliente         BigInt
  fecha_hora_ingreso DateTime
  fecha_hora_salida  DateTime?

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente])

  @@index([id_cliente])
  @@index([fecha_hora_ingreso])
  @@map("asistencia")
}

model Rutina {
  id_rutina      BigInt   @id @default(autoincrement())
  id_entrenador  BigInt
  nombre         String
  descripcion    String?
  fecha_creacion DateTime @default(now())
  estado         Boolean  @default(true)

  entrenador        Usuario           @relation(fields: [id_entrenador], references: [id_usuario])
  rutina_ejercicios RutinaEjercicio[]
  cliente_rutinas   ClienteRutina[]

  @@index([id_entrenador])
  @@map("rutina")
}

model Ejercicio {
  id_ejercicio   BigInt  @id @default(autoincrement())
  nombre         String
  grupo_muscular String
  descripcion    String?

  rutina_ejercicios RutinaEjercicio[]

  @@map("ejercicio")
}

model RutinaEjercicio {
  id_rutina      BigInt
  id_ejercicio   BigInt
  series         Int
  repeticiones   Int
  peso_sugerido  Decimal? @db.Decimal(6, 2)

  rutina    Rutina    @relation(fields: [id_rutina], references: [id_rutina])
  ejercicio Ejercicio @relation(fields: [id_ejercicio], references: [id_ejercicio])

  @@id([id_rutina, id_ejercicio])
  @@map("rutina_ejercicio")
}

model ClienteRutina {
  id_cliente_rutina BigInt   @id @default(autoincrement())
  id_cliente        BigInt
  id_rutina         BigInt
  fecha_asignacion  DateTime @db.Date
  estado            String

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente])
  rutina  Rutina  @relation(fields: [id_rutina], references: [id_rutina])

  @@index([id_cliente])
  @@map("cliente_rutina")
}

model Notificacion {
  id_notificacion BigInt   @id @default(autoincrement())
  id_cliente      BigInt
  titulo          String
  mensaje         String
  fecha_envio     DateTime @default(now())
  leida           Boolean  @default(false)

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente])

  @@map("notificacion")
}
