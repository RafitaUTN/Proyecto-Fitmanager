# ────────────────────────────────────────────
# FitManager — Variables de Entorno (raíz)
# Copia este archivo como .env y completa los valores
# ────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=fitmanager
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=fitmanager

# Backend — local
DATABASE_URL=postgresql://fitmanager:your_db_password_here@localhost:5432/fitmanager
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000/api
SEED_ON_STARTUP=false

# Email — Gmail (activo)
# ACTIVE_EMAIL_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# APP_ENV=development
# APP_URL=http://localhost:5173
# EMAIL_DEV_OVERRIDE=tu@correo.com

# Email — Resend (alternativo, futuro)
# ACTIVE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
