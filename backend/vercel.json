{
  "installCommand": "npm ci",
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/jobs/payment-window",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ]
}
