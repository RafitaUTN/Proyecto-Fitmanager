# FitManager — Backend
# Copia este archivo como .env y completa los valores
#
# Desarrollo local (Docker):
DATABASE_URL=postgresql://fitmanager:your_db_password_here@localhost:5432/fitmanager
# Producción (Supabase):
# DATABASE_URL=postgresql://postgres:password@db.<REF>.supabase.co:5432/postgres

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=3000
FRONTEND_URL=http://localhost:5173
# En producción cross-origin: COOKIE_SECURE=true y COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Confiar en el proxy para obtener la IP real del cliente.
# Default: 1 en producción (Vercel/nginx), false en desarrollo.
# OBLIGATORIO false si el backend se expone a Internet SIN reverse proxy.
# TRUST_PROXY=1
# Solo preview: sufijo de hosts autorizado, por ejemplo -mi-equipo.vercel.app
PREVIEW_ORIGIN_SUFFIX=
CRON_SECRET=replace_with_a_random_value_of_at_least_32_characters

# Email — Gmail (activo)
ACTIVE_EMAIL_PROVIDER=gmail
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
APP_ENV=development
APP_URL=http://localhost:5173
EMAIL_DEV_OVERRIDE=tu@correo.com
# EMAIL_FROM='FitManager <noreply@tudominio.com>'

# Email — Resend (alternativo, futuro)
# ACTIVE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx


# Catalogo de ejercicios (proveedor de media Wger) -- opcional, con defaults seguros
# EXERCISE_MEDIA_BASE_URL=https://wger.de
# EXERCISE_MEDIA_ENABLED=true
# EXERCISE_MEDIA_TIMEOUT_MS=6000
# EXERCISE_MEDIA_CACHE_TTL_MS=604800000
