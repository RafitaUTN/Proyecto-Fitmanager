# La app móvil empaqueta el frontend dentro del APK.
# No definas MOBILE_SERVER_URL: evitará que la app abra una URL externa protegida por Vercel.

# APK productivo / GitHub Actions
VITE_API_URL=https://fitmanager-backend-nine.vercel.app/api
VITE_ALLOW_ANDROID_EMULATOR_API=false

# Emulador local (sobrescribe las dos variables anteriores; nunca usar para producción)
# VITE_API_URL=http://10.0.2.2:3000/api
# VITE_ALLOW_ANDROID_EMULATOR_API=true
