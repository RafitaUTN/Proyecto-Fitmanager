# ────────────────────────────────────────────
# FitManager — Variables de Entorno (raíz)
# Copia este archivo como .env y completa los valores
# ────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=fitmanager
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=fitmanager

# Backend — local
DATABASE_URL=postgresql://fitmanager:your_db_password_here@localhost:5432/fitmanager
DATABASE_POOL_SIZE=10
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PREVIEW_ORIGIN_SUFFIX=
CRON_SECRET=replace_with_a_random_value_of_at_least_32_characters

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_MOBILE_WEB_URL=http://localhost:5173
VITE_ANDROID_APK_URL=https://github.com/RafitaUTN/Proyecto-Fitmanager/releases/latest/download/fitmanager-android.apk
# Solo para APK debug en emulador Android apuntando al backend local de Docker: http://10.0.2.2:3000/api
VITE_ALLOW_ANDROID_EMULATOR_API=false
# Solo para build móvil/Capacitor: iniciar directamente en login en vez de landing.
VITE_MOBILE_START_PATH=
# Solo para build móvil/Capacitor: desactiva el service worker para evitar caché antigua dentro del APK.
VITE_DISABLE_PWA_SW=
SEED_ON_STARTUP=false

# Email — Gmail (activo)
# ACTIVE_EMAIL_PROVIDER=gmail
# EMAIL_DELIVERY_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
# EMAIL_DEV_OVERRIDE=tu@correo.com

# Email — Resend (recomendado para producción en Vercel)
# ACTIVE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM='FitManager <onboarding@resend.dev>'
