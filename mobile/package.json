{
  "name": "fitmanager-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npx cap sync",
    "copy": "npx cap copy",
    "android": "npx cap open android",
    "doctor": "npx cap doctor",
    "build:android:debug": "npm run build:web && npx cap sync android && node scripts/gradle-build.mjs assembleDebug",
    "build:android:release": "npm run build:web && npx cap sync android && node scripts/gradle-build.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "typescript": "~6.0.2"
  }
}
