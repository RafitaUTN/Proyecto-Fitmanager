# ────────────────────────────────────────────
# FitManager — Variables de Entorno (raíz)
# Copia este archivo como .env y ajusta según tu entorno
# ────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=fitmanager
POSTGRES_PASSWORD=fitmanager_secret
POSTGRES_DB=fitmanager

# Backend — local
DATABASE_URL=postgresql://fitmanager:fitmanager_secret@localhost:5432/fitmanager
JWT_SECRET=dev_jwt_secret_key_2026
JWT_REFRESH_SECRET=dev_refresh_secret_key_2026
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000/api
