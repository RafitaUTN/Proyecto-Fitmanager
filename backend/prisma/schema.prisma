generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoNotificacion {
  MEMBRESIA
  TRANSFERENCIA
  SISTEMA
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

model HorarioEntrenador {
  id_horario    BigInt @id @default(autoincrement())
  id_entrenador BigInt
  dia_semana    Int
  hora_inicio   String
  hora_fin      String

  entrenador Usuario @relation(fields: [id_entrenador], references: [id_usuario], onDelete: Cascade)

  @@index([id_entrenador])
  @@map("horario_entrenador")
}

model Gimnasio {
  id_gimnasio    BigInt   @id @default(autoincrement())
  nombre         String
  correo         String   @unique
  telefono       String?
  direccion      String?
  estado         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuarios            Usuario[]
  clientes            Cliente[]
  membresias          Membresia[]
  ejercicios          Ejercicio[]
  rutinas             Rutina[]
  notificaciones      Notificacion[]
  pagos               Pago[]
  asistencias         Asistencia[]
  solicitudes_origen  SolicitudTransferencia[] @relation("solicitudes_origen")
  solicitudes_destino SolicitudTransferencia[] @relation("solicitudes_destino")

  @@map("gimnasio")
}

model Usuario {
  id_usuario     BigInt   @id @default(autoincrement())
  id_gimnasio    BigInt
  nombre         String
  apellido       String
  correo         String   @unique
  password_hash  String
  rol            String
  estado         Boolean  @default(true)
  capacidad_max  Int      @default(30)
  fecha_creacion DateTime @default(now())

  gimnasio                 Gimnasio                 @relation(fields: [id_gimnasio], references: [id_gimnasio])
  rutinas_creadas          Rutina[]                 @relation("rutinas_creadas")
  entrenamientos           RutinaEntrenador[]
  asignaciones_rutina      ClienteRutina[]          @relation("cliente_rutina_asignador")
  horarios                 HorarioEntrenador[]
  clientes_asignados       Cliente[]                @relation("cliente_entrenador")
  refresh_tokens           RefreshToken[]
  notificaciones_recibidas Notificacion[]           @relation("notificaciones_usuario")
  solicitudes_creadas      SolicitudTransferencia[] @relation("solicitudes_creadas")
  solicitudes_respondidas  SolicitudTransferencia[] @relation("solicitudes_respondidas")

  @@index([id_gimnasio])
  @@map("usuario")
}

model Cliente {
  id_cliente          BigInt    @id @default(autoincrement())
  id_gimnasio         BigInt
  id_entrenador       BigInt?
  nombre              String
  apellido            String
  cedula              String    @unique
  telefono            String?
  correo              String    @unique
  fecha_nacimiento    DateTime? @db.Date
  fecha_registro      DateTime  @default(now())
  estado              Boolean   @default(true)
  contrasena          String?
  contrasena_temporal Boolean   @default(false)
  ultimo_acceso       DateTime?

  gimnasio                  Gimnasio                 @relation(fields: [id_gimnasio], references: [id_gimnasio])
  entrenador                Usuario?                 @relation("cliente_entrenador", fields: [id_entrenador], references: [id_usuario])
  cliente_membresias        ClienteMembresia[]
  pagos                     Pago[]
  asistencias               Asistencia[]
  cliente_rutinas           ClienteRutina[]
  tokens                    Token[]
  refresh_tokens            ClienteRefreshToken[]
  notificaciones            Notificacion[]
  solicitudes_transferencia SolicitudTransferencia[]

  @@index([id_gimnasio])
  @@index([id_entrenador])
  @@index([correo])
  @@index([cedula])
  @@index([fecha_registro])
  @@map("cliente")
}

model Membresia {
  id_membresia  BigInt  @id @default(autoincrement())
  id_gimnasio   BigInt
  nombre        String
  descripcion   String?
  precio        Decimal @db.Decimal(10, 2)
  duracion_dias Int
  estado        Boolean @default(true)

  gimnasio           Gimnasio           @relation(fields: [id_gimnasio], references: [id_gimnasio])
  cliente_membresias ClienteMembresia[]

  @@index([id_gimnasio])
  @@map("membresia")
}

model ClienteMembresia {
  id_cliente_membresia BigInt   @id @default(autoincrement())
  id_cliente           BigInt
  id_membresia         BigInt
  fecha_inicio         DateTime @db.Date
  fecha_fin            DateTime @db.Date
  estado               String   @default("activo")

  cliente   Cliente   @relation(fields: [id_cliente], references: [id_cliente])
  membresia Membresia @relation(fields: [id_membresia], references: [id_membresia])
  pagos     Pago[]

  @@index([id_cliente])
  @@index([id_membresia])
  @@index([estado])
  @@index([id_cliente, estado])
  @@index([fecha_fin])
  @@index([fecha_inicio])
  @@map("cliente_membresia")
}

model Pago {
  id_pago              BigInt   @id @default(autoincrement())
  id_gimnasio          BigInt
  id_cliente           BigInt
  id_cliente_membresia BigInt
  monto                Decimal  @db.Decimal(10, 2)
  metodo_pago          String
  fecha_pago           DateTime @default(now())
  estado               String

  gimnasio          Gimnasio         @relation(fields: [id_gimnasio], references: [id_gimnasio])
  cliente           Cliente          @relation(fields: [id_cliente], references: [id_cliente])
  cliente_membresia ClienteMembresia @relation(fields: [id_cliente_membresia], references: [id_cliente_membresia])

  @@index([id_gimnasio])
  @@index([id_cliente])
  @@index([id_cliente_membresia])
  @@index([fecha_pago])
  @@index([estado])
  @@map("pago")
}

model Asistencia {
  id_asistencia      BigInt    @id @default(autoincrement())
  id_gimnasio        BigInt
  id_cliente         BigInt
  fecha_hora_ingreso DateTime
  fecha_hora_salida  DateTime?

  gimnasio Gimnasio @relation(fields: [id_gimnasio], references: [id_gimnasio])
  cliente  Cliente  @relation(fields: [id_cliente], references: [id_cliente])

  @@index([id_gimnasio])
  @@index([id_cliente])
  @@index([fecha_hora_ingreso])
  @@index([fecha_hora_salida])
  @@map("asistencia")
}

model Rutina {
  id_rutina          BigInt   @id @default(autoincrement())
  id_gimnasio        BigInt
  id_usuario_creador BigInt
  nombre             String
  descripcion        String?
  fecha_creacion     DateTime @default(now())
  estado             Boolean  @default(true)

  gimnasio          Gimnasio           @relation(fields: [id_gimnasio], references: [id_gimnasio])
  creador           Usuario            @relation("rutinas_creadas", fields: [id_usuario_creador], references: [id_usuario])
  rutina_ejercicios RutinaEjercicio[]
  entrenadores      RutinaEntrenador[]
  cliente_rutinas   ClienteRutina[]

  @@index([id_gimnasio])
  @@index([id_usuario_creador])
  @@map("rutina")
}

model Ejercicio {
  id_ejercicio   BigInt  @id @default(autoincrement())
  id_gimnasio    BigInt
  nombre         String
  grupo_muscular String
  descripcion    String?
  nivel          String  @default("principiante")
  categoria      String?
  estado         Boolean @default(true)

  gimnasio                  Gimnasio                 @relation(fields: [id_gimnasio], references: [id_gimnasio])
  rutina_ejercicios         RutinaEjercicio[]
  cliente_rutina_ejercicios ClienteRutinaEjercicio[]

  @@index([id_gimnasio])
  @@map("ejercicio")
}

model RutinaEjercicio {
  id_rutina     BigInt
  id_ejercicio  BigInt
  series        Int
  repeticiones  Int
  peso_sugerido Decimal? @db.Decimal(6, 2)

  rutina    Rutina    @relation(fields: [id_rutina], references: [id_rutina])
  ejercicio Ejercicio @relation(fields: [id_ejercicio], references: [id_ejercicio])

  @@id([id_rutina, id_ejercicio])
  @@map("rutina_ejercicio")
}

model RutinaEntrenador {
  id_rutina        BigInt
  id_entrenador    BigInt
  fecha_asignacion DateTime @default(now())
  estado           Boolean  @default(true)

  rutina     Rutina  @relation(fields: [id_rutina], references: [id_rutina], onDelete: Cascade)
  entrenador Usuario @relation(fields: [id_entrenador], references: [id_usuario], onDelete: Cascade)

  @@id([id_rutina, id_entrenador])
  @@index([id_entrenador])
  @@map("rutina_entrenador")
}

model ClienteRutina {
  id_cliente_rutina       BigInt    @id @default(autoincrement())
  id_cliente              BigInt
  id_rutina               BigInt
  id_entrenador_asignador BigInt?
  fecha_asignacion        DateTime  @db.Date
  fecha_inicio            DateTime? @db.Date
  fecha_fin               DateTime? @db.Date
  observaciones           String?
  estado                  String

  cliente    Cliente                  @relation(fields: [id_cliente], references: [id_cliente])
  rutina     Rutina                   @relation(fields: [id_rutina], references: [id_rutina])
  asignador  Usuario?                 @relation("cliente_rutina_asignador", fields: [id_entrenador_asignador], references: [id_usuario])
  ejercicios ClienteRutinaEjercicio[]

  @@index([id_cliente])
  @@index([id_rutina])
  @@index([id_entrenador_asignador])
  @@index([estado])
  @@index([id_cliente, estado], name: "idx_cliente_rutina_estado")
  @@map("cliente_rutina")
}

model ClienteRutinaEjercicio {
  id_cliente_rutina_ejercicio BigInt   @id @default(autoincrement())
  id_cliente_rutina           BigInt
  id_ejercicio                BigInt?
  nombre                      String
  grupo_muscular              String
  series                      Int
  repeticiones                Int
  peso                        Decimal? @db.Decimal(6, 2)
  descanso                    Int?
  observaciones               String?
  orden                       Int      @default(0)
  estado                      Boolean  @default(true)

  cliente_rutina ClienteRutina @relation(fields: [id_cliente_rutina], references: [id_cliente_rutina], onDelete: Cascade)
  ejercicio      Ejercicio?    @relation(fields: [id_ejercicio], references: [id_ejercicio], onDelete: SetNull)

  @@index([id_cliente_rutina])
  @@index([id_ejercicio])
  @@index([id_cliente_rutina, orden], name: "idx_cliente_rutina_ej_orden")
  @@map("cliente_rutina_ejercicio")
}

model SolicitudTransferencia {
  id                   BigInt          @id @default(autoincrement())
  id_cliente           BigInt
  id_gym_origen        BigInt
  id_gym_destino       BigInt
  estado               EstadoSolicitud @default(PENDIENTE)
  motivo               String?
  fecha_solicitud      DateTime        @default(now())
  fecha_respuesta      DateTime?
  id_usuario_solicita  BigInt
  id_usuario_respuesta BigInt?
  observaciones        String?
  ip_solicitud         String?
  ip_respuesta         String?

  cliente           Cliente              @relation(fields: [id_cliente], references: [id_cliente])
  gym_origen        Gimnasio             @relation("solicitudes_origen", fields: [id_gym_origen], references: [id_gimnasio])
  gym_destino       Gimnasio             @relation("solicitudes_destino", fields: [id_gym_destino], references: [id_gimnasio])
  usuario_solicita  Usuario              @relation("solicitudes_creadas", fields: [id_usuario_solicita], references: [id_usuario])
  usuario_respuesta Usuario?             @relation("solicitudes_respondidas", fields: [id_usuario_respuesta], references: [id_usuario])
  notificaciones    Notificacion[]
  auditorias        SolicitudAuditoria[]

  @@index([id_gym_origen, estado])
  @@index([id_gym_destino, estado])
  @@index([id_cliente, estado])
  @@index([fecha_solicitud])
  @@map("solicitud_transferencia")
}

model SolicitudAuditoria {
  id              BigInt   @id @default(autoincrement())
  id_solicitud    BigInt
  accion          String
  id_usuario      BigInt?
  fecha           DateTime @default(now())
  ip              String?
  estado_anterior String?
  estado_nuevo    String
  observaciones   String?

  solicitud SolicitudTransferencia @relation(fields: [id_solicitud], references: [id], onDelete: Cascade)

  @@index([id_solicitud])
  @@map("solicitud_auditoria")
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  id_usuario BigInt
  token_hash String   @unique
  expira_en  DateTime
  creado_en  DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([id_usuario])
  @@index([expira_en])
  @@map("refresh_token")
}

model ClienteRefreshToken {
  id         BigInt   @id @default(autoincrement())
  id_cliente BigInt
  token_hash String   @unique
  expira_en  DateTime
  creado_en  DateTime @default(now())

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)

  @@index([id_cliente])
  @@index([expira_en])
  @@map("cliente_refresh_token")
}

enum TipoToken {
  ACTIVACION
  RECUPERACION
  CAMBIO_CORREO
}

model Token {
  id         BigInt    @id @default(autoincrement())
  id_cliente BigInt
  tipo       TipoToken
  token_hash String    @unique
  expira_en  DateTime  @db.Timestamptz(3)
  usado_en   DateTime? @db.Timestamptz(3)
  creado_en  DateTime  @default(now()) @db.Timestamptz(3)
  creado_por BigInt?

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)

  @@index([id_cliente])
  @@index([tipo])
  @@index([expira_en])
  @@map("token")
}

model Notificacion {
  id_notificacion    BigInt           @id @default(autoincrement())
  id_cliente         BigInt?
  id_gimnasio        BigInt?
  id_solicitud       BigInt?
  id_usuario_destino BigInt?
  event_key          String?          @unique
  titulo             String
  mensaje            String
  tipo               TipoNotificacion @default(MEMBRESIA)
  fecha_envio        DateTime         @default(now())
  leida              Boolean          @default(false)

  cliente         Cliente?                @relation(fields: [id_cliente], references: [id_cliente])
  gimnasio        Gimnasio?               @relation(fields: [id_gimnasio], references: [id_gimnasio])
  solicitud       SolicitudTransferencia? @relation(fields: [id_solicitud], references: [id])
  usuario_destino Usuario?                @relation("notificaciones_usuario", fields: [id_usuario_destino], references: [id_usuario])

  @@index([id_gimnasio])
  @@index([id_usuario_destino])
  @@index([id_cliente])
  @@index([tipo])
  @@index([leida])
  @@index([fecha_envio])
  @@map("notificacion")
}

model EmailOutbox {
  id                BigInt    @id @default(autoincrement())
  destinatario      String
  asunto            String
  html              String
  texto             String    @default("")
  tipo              String
  estado            String    @default("PENDIENTE")
  intentos          Int       @default(0)
  ultimo_error      String?
  proximo_reintento DateTime?
  creado_en         DateTime  @default(now())
  enviado_en        DateTime?

  @@index([estado, proximo_reintento])
  @@map("email_outbox")
}
